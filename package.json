{
  "name": "identityhub-jira",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nest start --watch",
    "dev:client": "npm run dev --workspace client",
    "build": "nest build && npm run build --workspace client",
    "start": "node dist/main.js",
    "lint": "eslint src/ test/ client/src/ client/vite.config.ts && prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"client/src/**/*.{ts,tsx}\" \"*.md\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"client/src/**/*.{ts,tsx}\" \"client/vite.config.ts\" \"*.md\"",
    "prepare": "husky",
    "db:migrate": "npx prisma migrate dev --name init",
    "db:generate": "npx prisma generate",
    "db:switch-sqlite": "cp prisma/schema.sqlite.prisma prisma/schema.prisma",
    "db:switch-postgres": "cp prisma/schema.postgres.prisma prisma/schema.prisma"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": "prettier --write"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/throttler": "^6.2.0",
    "@prisma/client": "^6.12.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "nestjs-pino": "^4.3.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.2.0",
    "@swc/core": "^1.16.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.1.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.5.0",
    "prisma": "^6.12.0",
    "supertest": "^7.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.30.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^3.1.0"
  }
}
