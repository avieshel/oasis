NODE_ENV=development
PORT=3000
DATABASE_URL="file:./dev.db"
APP_SECRET=change-me-to-at-least-32-characters!!
ALLOW_OPEN_SIGNUP=true
ALLOW_ADMIN=true
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173
JIRA_CACHE_TTL_MS=60000
JIRA_PROJECTS_CACHE_TTL_MS=60000
SESSION_IDLE_TTL_MS=1800000        # 30 min
SESSION_ABSOLUTE_TTL_MS=43200000   # 12 h

# Rate-limit overrides (all optional, defaults below)
# RATE_LIMIT_GLOBAL_TTL_MS=60000
# RATE_LIMIT_GLOBAL_LIMIT=100
# RATE_LIMIT_LOGIN_TTL_MS=60000
# RATE_LIMIT_LOGIN_LIMIT=5
# RATE_LIMIT_SIGNUP_TTL_MS=60000
# RATE_LIMIT_SIGNUP_LIMIT=10
# RATE_LIMIT_TICKET_CREATE_UI_TTL_MS=60000
# RATE_LIMIT_TICKET_CREATE_UI_LIMIT=30
# RATE_LIMIT_TICKET_CREATE_API_TTL_MS=60000
# RATE_LIMIT_TICKET_CREATE_API_LIMIT=60
# RATE_LIMIT_API_KEY_CREATE_TTL_MS=60000
# RATE_LIMIT_API_KEY_CREATE_LIMIT=10
# RATE_LIMIT_API_KEY_USE_TTL_MS=60000
# RATE_LIMIT_API_KEY_USE_LIMIT=60
# RATE_LIMIT_JIRA_CONNECT_TTL_MS=60000
# RATE_LIMIT_JIRA_CONNECT_LIMIT=10
# RATE_LIMIT_JIRA_PROJECTS_TTL_MS=60000
# RATE_LIMIT_JIRA_PROJECTS_LIMIT=30
# RATE_LIMIT_ITEM_CREATE_TTL_MS=60000
# RATE_LIMIT_ITEM_CREATE_LIMIT=30
